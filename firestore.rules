rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Khedut Kharch — Firestore Security Rules
//
// Paths used by the app:
//   /users/{uid}                           – user profile + membership fields
//   /users/{uid}/seasons/{id}              – farming seasons (AppDataContext)
//   /users/{uid}/expenses/{id}             – expense records (AppDataContext)
//   /users/{uid}/documents/{id}            – wallet documents (base64, Firestore-only)
//   /donations/{id}                        – donation records (Settings page reads)
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email_verified == true && 
             request.auth.token.email == "shubhamnayani01@gmail.com";
    }

    function isSafeProfileCreate() {
      return request.resource.data.get('approvedBy', null) == null &&
             request.resource.data.get('membershipApprovedAt', null) == null &&
             (request.resource.data.get('membershipStatus', '') != 'Active' || request.resource.data.get('donationStatus', '') == 'Skipped');
    }

    function isSafeProfileUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return (!affected.hasAny(['approvedBy']) || request.resource.data.approvedBy == null) &&
             (!affected.hasAny(['membershipApprovedAt']) || request.resource.data.membershipApprovedAt == null) &&
             (!affected.hasAny(['membershipStatus']) || request.resource.data.membershipStatus != 'Active' || request.resource.data.get('donationStatus', '') == 'Skipped');
    }

    // ── /users/{uid} ─────────────────────────────────────────────────────────
    // Users can read and update their own document.
    // Admin can read all user documents (for the AdminPanel).
    // Users cannot delete their own profile document.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Create own profile (first sign-in via saveUserProfile)
      allow create: if isOwner(uid) && isSafeProfileCreate();

      // Update own profile (membership payment, skipDonation, auto-expire, etc.)
      // Prevent users from granting themselves Active membership or approving themselves.
      allow update: if isAdmin() || (isOwner(uid) && isSafeProfileUpdate());

      // Nobody deletes a user profile document via client
      allow delete: if false;

      // ── /users/{uid}/seasons/{seasonId} ──────────────────────────────────
      match /seasons/{seasonId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/expenses/{expenseId} ────────────────────────────────
      match /expenses/{expenseId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/workers/{workerId} ──────────────────────────────────
      match /workers/{workerId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/bhaagidars/{bhaagidarId} ────────────────────────────
      match /bhaagidars/{bhaagidarId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/advanceLedgers/{ledgerId} ───────────────────────────
      match /advanceLedgers/{ledgerId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/inventoryItems/{itemId} ─────────────────────────────
      match /inventoryItems/{itemId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/documents/{documentId} ──────────────────────────────
      // Khedut Wallet: PDF/image stored as base64 string directly in Firestore.
      // File size is capped at 500 KB on the client before upload.
      match /documents/{documentId} {
        allow read, delete: if isOwner(uid);
        
        // Ensure base64 payload stays under ~500KB (~700,000 characters)
        allow create, update: if isOwner(uid) && request.resource.data.get('base64Data', '').size() < 700000;
      }
    }

    // ── /donations/{donationId} ──────────────────────────────────────────────
    // Settings page queries donations by uid using where("uid", "==", user.uid).
    // Users may only read their own donation records.
    // Writes to donations are currently done by the admin or backend only —
    // keep write closed for regular users.
    match /donations/{donationId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    // ── /feedback/{ticketId} ─────────────────────────────────────────────────
    // Farmers can submit support tickets, but only Admin can read/manage them.
    match /feedback/{ticketId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}
