rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null &&
             request.auth.token.email.lower() in ['shubhamnayani01@gmail.com', 'shubhamnayani0110@gmail.com'];
    }

    function isSafeProfileCreate() {
      return request.resource.data.get('approvedBy', null) == null &&
             request.resource.data.get('membershipApprovedAt', null) == null &&
             (request.resource.data.get('membershipStatus', '') != 'Active' || request.resource.data.get('donationStatus', '') == 'Skipped');
    }

    function isSafeProfileUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      // Block self-approval fields
      let noSelfApproval = (!affected.hasAny(['approvedBy']) || request.resource.data.approvedBy == null) &&
                           (!affected.hasAny(['membershipApprovedAt']) || request.resource.data.membershipApprovedAt == null);
      // Allow user to set status to Trial / TrialExpired (trial lifecycle)
      // Also allow the existing Pending/Skipped path
      let safeStatus = !affected.hasAny(['membershipStatus']) ||
                       request.resource.data.membershipStatus == 'Trial' ||
                       request.resource.data.membershipStatus == 'TrialExpired' ||
                       request.resource.data.membershipStatus == 'Expired' ||
                       request.resource.data.membershipStatus == 'Pending' ||
                       (request.resource.data.membershipStatus == 'Active' && request.resource.data.get('donationStatus', '') == 'Skipped');
      return noSelfApproval && safeStatus;
    }

    // ── /users/{uid} ─────────────────────────────────────────────────────────
    // Users can read and update their own document.
    // Admin can read all user documents (for the AdminPanel).
    // Admin can delete user profile documents.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Create own profile (first sign-in via saveUserProfile)
      allow create: if isOwner(uid) && isSafeProfileCreate();

      // Update own profile (membership payment, skipDonation, auto-expire, etc.)
      // Prevent users from granting themselves Active membership or approving themselves.
      allow update: if isAdmin() || (isOwner(uid) && isSafeProfileUpdate());

      // Admin can delete a user profile document
      allow delete: if isAdmin();

      // ── /users/{uid}/seasons/{seasonId} ──────────────────────────────────
      match /seasons/{seasonId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/expenses/{expenseId} ────────────────────────────────
      match /expenses/{expenseId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/workers/{workerId} ──────────────────────────────────
      match /workers/{workerId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/bhaagidars/{bhaagidarId} ────────────────────────────
      match /bhaagidars/{bhaagidarId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/advanceLedgers/{ledgerId} ───────────────────────────
      match /advanceLedgers/{ledgerId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/inventoryItems/{itemId} ─────────────────────────────
      match /inventoryItems/{itemId} {
        allow read, write: if isOwner(uid);
      }

      // ── /users/{uid}/documents/{documentId} ──────────────────────────────
      // Khedut Wallet: PDF/image stored as base64 string directly in Firestore.
      match /documents/{documentId} {
        allow read, delete: if isOwner(uid);
        
        // Document create/update allowed if base64 payload is within limits.
        allow create, update: if isOwner(uid) && request.resource.data.get('base64Data', '').size() < 700000;
      }
    }

    // ── /donations/{donationId} ──────────────────────────────────────────────
    // Settings page queries donations by uid using where("uid", "==", user.uid).
    // Users may only read their own donation records.
    // Writes to donations are currently done by the admin or backend only —
    // keep write closed for regular users.
    match /donations/{donationId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    // ── /feedback/{ticketId} ─────────────────────────────────────────────────
    // Farmers can submit support tickets, but only Admin can read/manage them.
    match /feedback/{ticketId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}
